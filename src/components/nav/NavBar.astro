---
import LogoButton from '~/components/widgets/LogoButton.astro'
import Divider from '~/components/base/Divider.astro'
import SearchSwitch from '~/components/widgets/SearchSwitch.astro'
import ThemeSwitch from '~/components/widgets/ThemeSwitch.astro'
import RssLink from '~/components/widgets/RssLink.astro'
import NavItem from '~/components/nav/NavItem.astro'
import NavSwitch from '~/components/nav/NavSwitch.astro'

import { UI } from '~/config'
import { computeLocaleSwitchTarget } from '~/utils/locale-switch'
import { withBasePath } from '~/utils/path'

const { navBarLayout, internalNavs, socialLinks } = UI
const { left, right, mergeOnMobile } = navBarLayout

for (const item of new Set(left)) {
  if (new Set(right).has(item)) {
    throw new Error(
      `Duplicate '${item}' found in both 'UI.navBarLayout.left' and 'UI.navBarLayout.right'.`
    )
  }
}

/**
 * The locale switch button. The button is rendered as part of the
 * `internalNavs` group but its target URL is computed at request time
 * from the current path + locale so it jumps to the equivalent page in
 * the other language. Pages without a bilingual counterpart (e.g.
 * `/projects`, `/highlights`, `/404`) make this return null and the
 * button disappears entirely.
 */
const switchTarget = await computeLocaleSwitchTarget(
  Astro.url.pathname,
  Astro.locals.locale,
)
// `switchTarget.href` is a site-root path (e.g. `/blog/en/`); join it with
// the configured base so the rendered anchor works whether the site is
// served at the domain root or under a project path like
// `/SunOwen.github.io/`.
const switchHref = switchTarget ? withBasePath(switchTarget.href) : ''

/** Find the `localeSwitch: true` marker in `internalNavs` to read its
 * bilingual label. Falls back to a sensible default when the marker
 * isn't found (e.g. custom config without the locale switch). */
const locale = Astro.locals.locale
const switchItem = internalNavs.find(
  (item): item is Extract<(typeof internalNavs)[number], { localeSwitch: true }> =>
    'localeSwitch' in item,
)
function pickLabel<T>(
  map: Partial<Record<'zh-Hans' | 'en', T>> | undefined,
  staticValue: T,
): T {
  if (!map) return staticValue
  return (map as Record<string, T | undefined>)[locale] ?? staticValue
}
const switchLabel = pickLabel(
  switchItem?.titleI18n,
  switchItem?.title ?? 'Switch language',
)
const switchTitle = pickLabel(
  switchItem?.titleI18n,
  switchItem?.title ?? 'Switch language',
)

/** Items that have a real link to render (skip the `localeSwitch`
 * marker — that's handled separately below). The type predicate
 * narrows the array element type so each entry satisfies the
 * `LinkableInternalNav` shape that `NavItem` expects. */
const linkableNavs = internalNavs.filter(
  (item): item is Exclude<(typeof internalNavs)[number], { localeSwitch: true }> =>
    !('localeSwitch' in item),
)
---

<header
  class={`flex items-center gap-6 p-[1.75rem_2rem_2rem] ${mergeOnMobile ? 'lt-md:px-7' : 'lt-md:(px-6 gap-3)'}`}
>
  <LogoButton />
  <nav
    class={`flex items-center gap-4.8 w-full lt-md:justify-end
    ${left.length !== 0 ? (right.length !== 0 ? 'justify-between' : '') : 'justify-end'}`}
    aria-label="Main menu"
  >
    {
      left.length !== 0 && (
        <div
          class={`grid grid-flow-col items-center gap-4.8 print:op-0 ${mergeOnMobile ? '' : 'lt-md:(gap-3)'}`}
        >
          {left.map((key) =>
            key === 'hr' ? (
              <Divider class={mergeOnMobile ? 'lt-md:hidden' : undefined} />
            ) : key === 'searchButton' ? (
              <SearchSwitch />
            ) : key === 'themeButton' ? (
              <ThemeSwitch />
            ) : key === 'rssLink' ? (
              <RssLink class={mergeOnMobile ? 'lt-md:hidden' : undefined} />
            ) : key === 'internalNavs' ? (
              <>
                {linkableNavs.map((item) => (
                  <NavItem type="internal" {item} {mergeOnMobile} />
                ))}
                {switchTarget && (
                  <a
                    href={switchHref}
                    title={switchTitle}
                    aria-label={switchLabel}
                    class="op-60 no-underline hover:op-100 op-transition"
                  >
                    <span class="i-ri-translate-2" aria-hidden="true" />
                  </a>
                )}
              </>
            ) : (
              socialLinks.map((item) => (
                <NavItem type="social" {item} {mergeOnMobile} />
              ))
            )
          )}
        </div>
      )
    }
    {
      right.length !== 0 && (
        <div
          class={`grid grid-flow-col items-center gap-4.8 print:op-0
              ${!right.includes('themeButton') && !right.includes('searchButton') && 'lt-md:hidden'}
              ${mergeOnMobile ? '' : 'lt-md:(gap-3)'}`}
        >
          {right.map((key) =>
            key === 'hr' ? (
              <Divider class={mergeOnMobile ? 'lt-md:hidden' : undefined} />
            ) : key === 'searchButton' ? (
              <SearchSwitch />
            ) : key === 'themeButton' ? (
              <ThemeSwitch />
            ) : key === 'rssLink' ? (
              <RssLink class={mergeOnMobile ? 'lt-md:hidden' : undefined} />
            ) : key === 'internalNavs' ? (
              <>
                {linkableNavs.map((item) => (
                  <NavItem type="internal" {item} {mergeOnMobile} />
                ))}
                {switchTarget && (
                  <a
                    href={switchHref}
                    title={switchTitle}
                    aria-label={switchLabel}
                    class="op-60 no-underline hover:op-100 op-transition"
                  >
                    <span class="i-ri-translate-2" aria-hidden="true" />
                  </a>
                )}
              </>
            ) : (
              socialLinks.map((item) => (
                <NavItem type="social" {item} {mergeOnMobile} />
              ))
            )
          )}
        </div>
      )
    }
    {
      mergeOnMobile && (
        <NavSwitch>
          <Fragment slot="text">
            {linkableNavs.length !== 0 &&
              linkableNavs.map((item) => (
                <NavItem
                  type="internal"
                  {item}
                  {mergeOnMobile}
                  mobileItemType="text"
                />
              ))}
            {socialLinks.length !== 0 &&
              socialLinks.map((item) => (
                <NavItem
                  type="social"
                  {item}
                  {mergeOnMobile}
                  mobileItemType="text"
                />
              ))}
          </Fragment>
          <Fragment slot="icon">
            {linkableNavs.length !== 0 &&
              linkableNavs.map((item) => (
                <NavItem
                  type="internal"
                  {item}
                  {mergeOnMobile}
                  mobileItemType="icon"
                />
              ))}
            {socialLinks.length !== 0 &&
              socialLinks.map((item) => (
                <NavItem
                  type="social"
                  {item}
                  {mergeOnMobile}
                  mobileItemType="icon"
                />
              ))}
            <RssLink class="op-50!" />
          </Fragment>
        </NavSwitch>
      )
    }
  </nav>
</header>