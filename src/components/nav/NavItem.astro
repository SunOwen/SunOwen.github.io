---
import Link from '~/components/base/Link.astro'
import { resolvePath } from '~/utils/path'

import type { InternalNav, SocialLink } from '~/types'

/** `InternalNav` minus the `localeSwitch` marker — that one is rendered
 * separately by `NavBar.astro`. */
type LinkableInternalNav = Exclude<InternalNav, { localeSwitch: true }>

type Props =
  | {
      type: 'internal'
      item: LinkableInternalNav
      mergeOnMobile: boolean
      mobileItemType?: 'text' | 'icon'
    }
  | {
      type: 'social'
      item: SocialLink
      mergeOnMobile: boolean
      mobileItemType?: 'text' | 'icon'
    }

const { type, item, mergeOnMobile, mobileItemType } = Astro.props

const locale = Astro.locals.locale

/**
 * Pick the per-locale value from an optional i18n map, falling back to
 * `staticValue` when the map is missing or has no entry for the current
 * locale.
 */
function pickI18n<T>(
  map: Partial<Record<'zh-Hans' | 'en', T>> | undefined,
  staticValue: T,
): T {
  if (!map) return staticValue
  return (map as Record<string, T | undefined>)[locale] ?? staticValue
}

// `item.text` lives on TextNavItem / ResponsiveNavItem only; IconNavItem
// uses an icon instead. We narrow before reading. Social links don't carry
// `textI18n` / `titleI18n` (they live on `BaseNavItem`, which `SocialLink`
// doesn't extend), so we gate the i18n pick on the field's presence.
const itemText =
  'text' in item ? (item as { text?: string }).text : undefined
const titleI18n =
  'titleI18n' in item
    ? (item as { titleI18n?: Record<'zh-Hans' | 'en', string> }).titleI18n
    : undefined
const textI18n =
  'textI18n' in item
    ? (item as { textI18n?: Record<'zh-Hans' | 'en', string> }).textI18n
    : undefined
const titleResolved = pickI18n(titleI18n, item.title)
const textResolved = pickI18n(textI18n, itemText ?? '')

const href = type == 'internal' ? resolvePath(item.path) : item.link
const rel = type === 'internal' ? undefined : 'me'
const external = type === 'internal' ? false : true
const ariaCurrent =
  type === 'internal'
    ? Astro.url.pathname === resolvePath(item.path)
      ? 'page'
      : false
    : undefined
---

{
  mergeOnMobile ? (
    mobileItemType ? (
      mobileItemType === 'text' ? (
        (item.displayMode === 'alwaysText' ||
          item.displayMode === 'iconToTextOnMobile') && (
          <li class="block py-3 border-b b-[var(--c-scrollbar)] leading-6">
            <Link
              class="block op-50! op-transition"
              href={href}
              title={titleResolved}
              rel={rel}
              external={external}
              aria-current={ariaCurrent}
            >
              <span>{textResolved}</span>
            </Link>
          </li>
        )
      ) : (
        (item.displayMode === 'alwaysIcon' ||
          item.displayMode === 'textToIconOnMobile') && (
          <Link
            class="block op-50! op-transition"
            href={href}
            title={titleResolved}
            rel={rel}
            external={external}
            aria-current={ariaCurrent}
          >
            <div class={item.icon} />
          </Link>
        )
      )
    ) : (
      <Link
        class="lt-md:hidden op-50! op-transition"
        href={href}
        title={titleResolved}
        rel={rel}
        external={external}
        aria-current={ariaCurrent}
      >
        {(item.displayMode === 'alwaysIcon' ||
          item.displayMode === 'iconHiddenOnMobile' ||
          item.displayMode === 'iconToTextOnMobile') && (
          <div class={item.icon} />
        )}
        {(item.displayMode === 'alwaysText' ||
          item.displayMode === 'textHiddenOnMobile' ||
          item.displayMode === 'textToIconOnMobile') && (
          <span>{textResolved}</span>
        )}
      </Link>
    )
  ) : (
    <Link
      class={`${
        item.displayMode === 'iconHiddenOnMobile' ||
        item.displayMode === 'textHiddenOnMobile'
          ? 'lt-md:hidden'
          : ''
      } op-transition`}
      href={href}
      title={titleResolved}
      rel={rel}
      external={external}
      aria-current={ariaCurrent}
    >
      {(item.displayMode === 'alwaysText' ||
        item.displayMode === 'textHiddenOnMobile') && <span>{textResolved}</span>}
      {(item.displayMode === 'alwaysIcon' ||
        item.displayMode === 'iconHiddenOnMobile') && <div class={item.icon} />}
      {item.displayMode === 'textToIconOnMobile' && (
        <>
          <span class="lt-md:hidden">{textResolved}</span>
          <div class={`md:hidden ${item.icon}`} />
        </>
      )}
      {item.displayMode === 'iconToTextOnMobile' && (
        <>
          <span class="md:hidden">{textResolved}</span>
          <div class={`lt-md:hidden ${item.icon}`} />
        </>
      )}
    </Link>
  )
}
