---
import Link from '~/components/base/Link.astro'
import { LOCALE_META, t } from '~/utils/i18n'

import type { TranslationLink } from '~/utils/translations'

interface Props {
  translations: TranslationLink[]
}

const { translations } = Astro.props
const current = Astro.locals.locale
if (translations.length === 0) return
---

<nav
  class="lang-switch mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm op-50"
  aria-label={t(current, 'language')}
>
  <span class="i-ri-translate-2 align-middle" aria-hidden="true" />
  <span class="op-70">{t(current, 'alsoAvailableIn')}</span>
  <span aria-hidden="true">:</span>
  {
    translations.map((item, idx) => (
      <>
        {idx > 0 && <span class="op-25" aria-hidden="true">/</span>}
        <Link
          class="op-70! hover:op-100! op-transition"
          href={item.href}
          title={item.title}
          hreflang={LOCALE_META[item.locale].lang}
        >
          {item.label}
        </Link>
      </>
    ))
  }
</nav>
