---
import { getEntry, render } from 'astro:content'

import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'

const entry = await getEntry('home', 'index.en')
if (!entry) {
  throw new Error(
    'No homepage content for English. Add src/content/home/index.en.md',
  )
}

const { Content } = await render(entry)

const { title, description, bgType, ogImage } = entry.data
const subtitle = 'subtitle' in entry.data ? (entry.data.subtitle as string) : ''
---

<BaseLayout title={title} description={description} bgType={bgType} ogImage={ogImage}>
  <StandardLayout title={title} subtitle={subtitle}>
    <Content slot="article" />
  </StandardLayout>
</BaseLayout>