---
import { getEntry, render } from 'astro:content'

import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import { LOCALE_META } from '~/utils/i18n'

const locale = Astro.locals.locale
const dir = LOCALE_META[locale].dir
// Default locale lives at `index`; prefixed locales at `index.<dir>`.
// The home collection lives at `src/content/home/` and is *not* nested in a
// locale subdirectory, so only non-default locales need the suffix.
const entryId = dir ? `index.${dir}` : 'index'

const entry = await getEntry('home', entryId)
if (!entry) {
  throw new Error(
    `No homepage content for locale "${locale}". Add src/content/home/${entryId}.md`,
  )
}

const { Content } = await render(entry)

const { title, description, bgType, ogImage } = entry.data
const subtitle = 'subtitle' in entry.data ? (entry.data.subtitle as string) : ''
---

<BaseLayout title={title} description={description} bgType={bgType} ogImage={ogImage}>
  <StandardLayout title={title} subtitle={subtitle}>
    <Content slot="article" />
  </StandardLayout>
</BaseLayout>